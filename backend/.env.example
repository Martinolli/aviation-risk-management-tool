# Copy this file to backend/.env when running backend commands from backend/.
# Use stronger private credentials and secrets outside local development.

# Application environment
ENVIRONMENT=development

# Database
# Production must not use local PostgreSQL default credentials.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aviation_risk_management

# Authentication
# Production must override JWT_SECRET_KEY with a long random secret.
JWT_SECRET_KEY=dev-change-me-use-env-secret-in-production-32bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Development compatibility
# Production must keep ENABLE_X_USER_ID_AUTH_FALLBACK=false.
ENABLE_X_USER_ID_AUTH_FALLBACK=false

# CORS
# Production must use explicit HTTPS frontend origin.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
ALLOW_LOCALHOST_CORS_IN_PRODUCTION=false

# Service URLs
FRONTEND_BASE_URL=http://localhost:5174
BACKEND_BASE_URL=http://127.0.0.1:8000

# Storage
EVIDENCE_STORAGE_DIR=backend/evidence_uploads
GENERATED_REPORTS_DIR=backend/generated_reports
MAX_EVIDENCE_UPLOAD_MB=25

# Production safety
REQUIRE_SECURE_PRODUCTION_SETTINGS=true

# Logging / operational diagnostics
# Production should normally use INFO or WARNING.
# DEBUG must not be enabled in production unless temporarily approved for troubleshooting.
# Do not log secrets, JWTs, passwords, request bodies, or uploaded evidence contents.
LOG_LEVEL=INFO
LOG_FORMAT=plain
ENABLE_REQUEST_LOGGING=true
LOG_REQUEST_HEADERS=false
LOG_RESPONSE_STATUS=true
LOG_REQUEST_DURATION=true
REQUEST_ID_HEADER=X-Request-ID
ALLOW_DEBUG_LOGGING_IN_PRODUCTION=false
